# Copien este archivo como .env (en la raíz del repo) y pongan su clave real. El .env NO se sube a Git.

# ---- Modelo de IA (cualquier API compatible con OpenAI) ----
# Opción A: Groq (gratis, muy rápido)   → claves en https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=llama-3.3-70b-versatile
# Opción B: Gemini (gratis)             → claves en https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODELO=gemini-2.5-flash
# Opción C: OpenAI (de pago)            → dejen LLM_BASE_URL vacío
# LLM_MODELO=gpt-4o-mini
# Revisen en la consola del proveedor que el nombre del modelo siga disponible.
LLM_API_KEY=

# ---- Embeddings y recuperación ----
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ESTRATEGIA=estructural

# ---- Puertos y CORS ----
PUERTO_MOTOR=8000
PUERTO_BACKEND=3001
MOTOR_URL=http://localhost:8000
URL_BACKEND=http://localhost:3001
ORIGENES_PERMITIDOS=http://localhost:5173
# máximo de preguntas por minuto por IP (protege la cuota del modelo de IA)
LIMITE_CHAT_POR_MINUTO=20

# ---- Frontend (Vite solo expone las variables que empiezan por VITE_) ----
VITE_API_URL=http://localhost:3001
# true = respuestas de ejemplo, sin backend ni motor (para trabajar el frontend)
VITE_DEMO=false
